BASE_HTTP_URL=https://mainnet.base.org
BASE_WSS_URL=wss://mainnet.base.org
BASE_CHAIN_ID=8453
START_BLOCK=0
RPC_REQUEST_TIMEOUT=15s
RPC_RECONNECT_DELAY=3s
REGISTRY_ENRICHMENT_TIMEOUT=100ms
REGISTRY_BACKFILL_BATCH_SIZE=100
REGISTRY_BACKFILL_BATCH_TIMEOUT=2m
REGISTRY_BACKFILL_SCAN_INTERVAL=30s

REDPANDA_BROKERS=localhost:19092
REDPANDA_RAW_BLOCK_TOPIC=base.block.raw.v1
REDPANDA_CONSUMER_GROUP=base-clickhouse-writer-v1
REDPANDA_EVENT_PARSER_CONSUMER_GROUP=base-event-parser-v4

POSTGRES_DSN=postgres://base:base@localhost:5432/base?sslmode=disable
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DATABASE=base
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

LOG_LEVEL=info
